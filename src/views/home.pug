
doctype html
html(lang="ko")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Noom
    link(rel="stylesheet", href="/public/css/reset.css")
    link(rel="stylesheet", href="/public/css/styles.css")

  body
    header
      h1 Noom

    main
      section#welcome
        form
          input#roomInput(
            type="text"
            placeholder="Room name"
            maxlength="80"
            required
          )
          input#nicknameInput(
            type="text"
            placeholder="Your nickname"
            maxlength="30"
            required
          )
          button(type="submit") Enter Room

      section#call(hidden)
        div#meetingLayout
          section#sharedPanel(hidden)
            h2#screenTitle 공유 화면
            video#sharedScreen(
              autoplay
              playsinline
              muted
            )

          section#cameraPanel
            div#videoGrid
              div.videoCard#myVideoCard
                h3#myVideoName 나
                video#myFace(
                  autoplay
                  playsinline
                  muted
                )

        div#controls
          button#mute(type="button") Mute
          button#camera(type="button") Turn Camera Off
          button#screenShare(type="button") Share Screen
          select#cameras
          button#leaveRoom(type="button") 🔴 Leave Room

        section#participants
          h3
            | 참가자 목록 (
            span#participantCount 0
            | /10)
          ul#participantList

        section#chat
          h3 Data Channel Chat
          ul#chatList

          form#chatForm
            input(
              type="text"
              placeholder="메시지 입력"
              required
            )
            button(type="submit") Send

    script(src="/socket.io/socket.io.js")
    script(src="/public/js/app.js")
